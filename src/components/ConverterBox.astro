---
const INPUT_FORMATS = [
  'AUTO (Detect Automatically)',
  'MP4',
  'MOV',
  'MKV',
  'AVI',
  'WEBM',
  'HEVC',
  'MTS',
  'DAV',
  'MPEG',
  'MPG',
  'GIF',
  'MP3',
  'WAV',
  'M4A',
  'FLV',
];

const OUTPUT_FORMATS = [
  { value: 'mp4', label: 'MP4 (H.264 / Universal Video)' },
  { value: 'mp3', label: 'MP3 (320kbps High-Fidelity Audio)' },
  { value: 'gif', label: 'GIF (Animated Loop)' },
  { value: 'wav', label: 'WAV (Lossless PCM Audio)' },
  { value: 'webm', label: 'WEBM (VP9 / Web Video)' },
  { value: 'mov', label: 'MOV (Apple QuickTime Pro)' },
];
---

<div
  id="converter-engine-box"
  class="w-full max-w-4xl mx-auto bg-white/95 dark:bg-[#1C1917] border-2 border-[#E5D3AF] dark:border-[#3A332C] rounded-3xl shadow-2xl p-4 sm:p-6 md:p-7 text-left transition-all duration-300 ease-smooth"
>
  <!-- Quick Preset Tabs -->
  <div class="mb-4">
    <div
      role="tablist"
      aria-label="Quick Conversion Presets"
      class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2"
    >
      <button
        type="button"
        role="tab"
        aria-selected="true"
        data-preset="to-mp4"
        data-target-out="mp4"
        class="preset-tab min-w-0 px-3 py-2.5 rounded-xl font-bold text-xs sm:text-sm leading-tight text-center break-words border-2 border-[#790D16] bg-[#790D16] text-[#F5EFE1] shadow-sm transition-all duration-200 ease-smooth focus:outline-none focus-visible:ring-4 focus-visible:ring-[#AEC4D4]"
        data-i18n="preset_to_mp4"
      >
        Convert to MP4
      </button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-preset="mp4-to-mp3"
        data-target-out="mp3"
        class="preset-tab min-w-0 px-3 py-2.5 rounded-xl font-bold text-xs sm:text-sm leading-tight text-center break-words border-2 border-[#E5D3AF] dark:border-[#3A332C] bg-[#F5EFE1]/70 dark:bg-[#12100E] text-[#12100E] dark:text-[#F5EFE1] hover:border-[#790D16] transition-all duration-200 ease-smooth focus:outline-none focus-visible:ring-4 focus-visible:ring-[#AEC4D4]"
        data-i18n="preset_mp4_to_mp3"
      >
        MP4 to MP3
      </button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-preset="compress-mp4"
        data-target-out="mp4"
        class="preset-tab min-w-0 px-3 py-2.5 rounded-xl font-bold text-xs sm:text-sm leading-tight text-center break-words border-2 border-[#E5D3AF] dark:border-[#3A332C] bg-[#F5EFE1]/70 dark:bg-[#12100E] text-[#12100E] dark:text-[#F5EFE1] hover:border-[#790D16] transition-all duration-200 ease-smooth focus:outline-none focus-visible:ring-4 focus-visible:ring-[#AEC4D4]"
        data-i18n="preset_compress_mp4"
      >
        Compress MP4
      </button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-preset="mp4-to-gif"
        data-target-out="gif"
        class="preset-tab min-w-0 px-3 py-2.5 rounded-xl font-bold text-xs sm:text-sm leading-tight text-center break-words border-2 border-[#E5D3AF] dark:border-[#3A332C] bg-[#F5EFE1]/70 dark:bg-[#12100E] text-[#12100E] dark:text-[#F5EFE1] hover:border-[#790D16] transition-all duration-200 ease-smooth focus:outline-none focus-visible:ring-4 focus-visible:ring-[#AEC4D4]"
        data-i18n="preset_mp4_to_gif"
      >
        MP4 to GIF
      </button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-preset="camera-to-mp4"
        data-target-out="mp4"
        class="preset-tab col-span-2 sm:col-span-2 lg:col-span-1 min-w-0 px-2.5 py-2.5 rounded-xl font-bold text-xs sm:text-sm leading-tight text-center break-words border-2 border-[#E5D3AF] dark:border-[#3A332C] bg-[#F5EFE1]/70 dark:bg-[#12100E] text-[#12100E] dark:text-[#F5EFE1] hover:border-[#790D16] transition-all duration-200 ease-smooth focus:outline-none focus-visible:ring-4 focus-visible:ring-[#AEC4D4]"
        data-i18n="preset_camera_to_mp4"
      >
        MOV / MKV / AVI to MP4
      </button>
    </div>
  </div>

  <!-- Format Selector Pill Bar -->
  <div class="grid grid-cols-1 md:grid-cols-11 gap-2.5 items-center bg-[#F5EFE1] dark:bg-[#12100E] border-2 border-[#E5D3AF] dark:border-[#3A332C] p-3 rounded-2xl mb-4">
    <div class="md:col-span-5 min-w-0">
      <label
        for="input-format-select"
        class="block text-[11px] font-extrabold uppercase tracking-wider text-[#12100E]/75 dark:text-[#F5EFE1]/75 mb-1"
        data-i18n="convert_from"
      >
        Input Format
      </label>
      <select
        id="input-format-select"
        aria-label="Convert From Input Format"
        class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#1C1917] border-2 border-[#E5D3AF] dark:border-[#3A332C] text-[#12100E] dark:text-[#F5EFE1] font-bold text-sm sm:text-base focus:outline-none focus:border-[#790D16] focus:ring-2 focus:ring-[#AEC4D4]"
      >
        {INPUT_FORMATS.map((fmt) => <option value={fmt}>{fmt}</option>)}
      </select>
    </div>

    <div class="md:col-span-1 flex items-center justify-center">
      <div class="w-9 h-9 rounded-full bg-[#790D16] dark:bg-[#A31621] text-[#F5EFE1] flex items-center justify-center shadow-sm shrink-0">
        <svg class="w-5 h-5 rotate-90 md:rotate-0 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </div>
    </div>

    <div class="md:col-span-5 min-w-0">
      <label
        for="output-format-select"
        class="block text-[11px] font-extrabold uppercase tracking-wider text-[#12100E]/75 dark:text-[#F5EFE1]/75 mb-1"
        data-i18n="convert_to"
      >
        Output Format
      </label>
      <select
        id="output-format-select"
        aria-label="Convert To Output Format"
        class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#1C1917] border-2 border-[#790D16] dark:border-[#A31621] text-[#12100E] dark:text-[#F5EFE1] font-extrabold text-sm sm:text-base focus:outline-none focus:ring-4 focus:ring-[#AEC4D4]"
      >
        {OUTPUT_FORMATS.map((fmt) => <option value={fmt.value}>{fmt.label}</option>)}
      </select>
    </div>
  </div>

  <!-- Hidden File Input (Accessible by both Dropzone and Change File button) -->
  <input
    id="file-input"
    type="file"
    accept="video/*,audio/*,.mp4,.mov,.mkv,.avi,.webm,.hevc,.mts,.dav,.mpeg,.mpg,.gif,.mp3,.wav,.m4a,.flv"
    class="sr-only"
    aria-label="Upload Video or Audio File for Local RAM Conversion"
  />

  <!-- Step 2A: Oversized Drag & Drop Zone (Auto-hides once a file is uploaded!) -->
  <div
    id="dropzone-area"
    tabindex="0"
    role="button"
    aria-label="Drag and drop video, audio, or GIF file here, or press Enter to select a file from your device"
    class="group relative border-2 border-dashed border-[#E5D3AF] dark:border-[#3A332C] hover:border-[#790D16] dark:hover:border-[#A31621] bg-[#F5EFE1]/50 dark:bg-[#12100E]/70 rounded-2xl p-6 sm:p-8 text-center cursor-pointer transition-all duration-300 ease-smooth focus:outline-none focus-visible:ring-4 focus-visible:ring-[#AEC4D4]"
  >
    <div class="mx-auto w-14 h-14 rounded-2xl bg-[#E5D3AF]/60 dark:bg-[#3A332C] text-[#790D16] dark:text-[#F5EFE1] flex items-center justify-center mb-3 group-hover:scale-110 group-hover:bg-[#790D16] group-hover:text-[#F5EFE1] transition-all duration-300 ease-smooth shadow-md">
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
      </svg>
    </div>

    <h2
      id="dropzone-heading"
      class="text-xl sm:text-2xl font-extrabold text-[#12100E] dark:text-[#F5EFE1] mb-1.5 tracking-tight"
      data-i18n="dropzone_title"
    >
      Drag & Drop Video, Audio, or GIF File Here
    </h2>

    <p
      id="dropzone-subtext"
      class="text-xs sm:text-sm text-[#12100E]/80 dark:text-[#F5EFE1]/80 max-w-xl mx-auto mb-4 font-medium"
      data-i18n="dropzone_subtitle"
    >
      Supports MP4, MOV, MKV, AVI, WEBM, HEVC, MTS, DAV, MPEG, MPG, GIF, MP3, WAV, M4A, FLV
    </p>

    <span
      class="inline-flex items-center justify-center gap-2.5 px-6 py-3 rounded-xl bg-[#790D16] dark:bg-[#A31621] text-[#F5EFE1] font-extrabold text-base sm:text-lg shadow-lg group-hover:shadow-xl group-hover:scale-[1.02] transition-all duration-200 ease-smooth"
    >
      <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
      <span data-i18n="dropzone_btn">Select Video or Audio File</span>
    </span>
  </div>

  <!-- Step 2B: Active File Workspace (Replaces Dropzone once user selects a file) -->
  <div
    id="selected-file-panel"
    class="hidden p-4 sm:p-5 rounded-2xl bg-[#F5EFE1] dark:bg-[#12100E] border-2 border-[#790D16]/40 dark:border-[#A31621]/50 transition-all duration-300"
  >
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3 min-w-0 flex-1">
        <div
          class="w-12 h-12 rounded-xl bg-[#790D16] dark:bg-[#A31621] text-[#F5EFE1] flex items-center justify-center shrink-0 font-black text-xs uppercase shadow-sm"
          id="file-ext-badge"
        >
          MP4
        </div>
        <div class="min-w-0 flex-1">
          <p
            id="selected-file-name"
            class="text-base sm:text-lg font-extrabold text-[#12100E] dark:text-[#F5EFE1] truncate"
          >
            sample-video.mov
          </p>
          <div class="flex flex-wrap items-center gap-2 mt-0.5">
            <span
              id="selected-file-meta"
              class="text-xs sm:text-sm font-semibold text-[#12100E]/75 dark:text-[#F5EFE1]/75"
            >
              0 MB • Ready
            </span>
            <button
              id="change-file-btn"
              type="button"
              class="text-xs font-extrabold text-[#790D16] dark:text-[#AEC4D4] underline hover:opacity-80 focus:outline-none"
            >
              Change File
            </button>
          </div>
        </div>
      </div>

      <button
        id="start-convert-btn"
        type="button"
        class="w-full sm:w-auto shrink-0 px-8 py-3.5 rounded-xl bg-[#790D16] dark:bg-[#A31621] text-[#F5EFE1] font-extrabold text-base sm:text-lg shadow-lg hover:opacity-95 focus:outline-none focus-visible:ring-4 focus-visible:ring-[#AEC4D4] flex items-center justify-center gap-2 transition-all duration-200"
      >
        <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
        </svg>
        <span data-i18n="btn_convert_now">Convert</span>
      </button>
    </div>
  </div>

  <!-- Advanced Conversion Settings Accordion -->
  <details class="mt-3.5 group bg-[#F5EFE1]/60 dark:bg-[#12100E]/60 border-2 border-[#E5D3AF] dark:border-[#3A332C] rounded-2xl overflow-hidden">
    <summary class="px-4 py-3 cursor-pointer font-bold text-sm sm:text-base text-[#12100E] dark:text-[#F5EFE1] flex items-center justify-between select-none focus:outline-none focus-visible:ring-4 focus-visible:ring-[#AEC4D4]">
      <span class="flex items-center gap-2">
        <svg class="w-5 h-5 text-[#790D16] dark:text-[#AEC4D4] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75" />
        </svg>
        <span data-i18n="settings_toggle">Conversion Settings (Resolution, Compression, Bitrate & Trim)</span>
      </span>
      <svg class="w-4 h-4 shrink-0 group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </summary>

    <div class="p-4 pt-2 border-t border-[#E5D3AF] dark:border-[#3A332C] grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      <div>
        <label for="setting-resolution" class="block text-xs font-bold text-[#12100E] dark:text-[#F5EFE1] mb-1" data-i18n="setting_resolution">
          Video Resolution
        </label>
        <select
          id="setting-resolution"
          class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#1C1917] border border-[#E5D3AF] dark:border-[#3A332C] text-[#12100E] dark:text-[#F5EFE1] text-sm font-semibold"
        >
          <option value="original">Original Resolution (Keep Source)</option>
          <option value="1920:1080">1080p Full HD (1920×1080)</option>
          <option value="1280:720">720p HD (1280×720)</option>
          <option value="854:480">480p Compact (854×480)</option>
        </select>
      </div>

      <div>
        <label for="setting-quality" class="block text-xs font-bold text-[#12100E] dark:text-[#F5EFE1] mb-1" data-i18n="setting_quality">
          Compression Quality
        </label>
        <select
          id="setting-quality"
          class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#1C1917] border border-[#E5D3AF] dark:border-[#3A332C] text-[#12100E] dark:text-[#F5EFE1] text-sm font-semibold"
        >
          <option value="23">Balanced Quality & Speed (CRF 23)</option>
          <option value="18">High Studio Quality (CRF 18)</option>
          <option value="28">Maximum Compression / Smaller File (CRF 28)</option>
        </select>
      </div>

      <div>
        <label for="setting-bitrate" class="block text-xs font-bold text-[#12100E] dark:text-[#F5EFE1] mb-1" data-i18n="setting_audio_bitrate">
          Audio Bitrate
        </label>
        <select
          id="setting-bitrate"
          class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#1C1917] border border-[#E5D3AF] dark:border-[#3A332C] text-[#12100E] dark:text-[#F5EFE1] text-sm font-semibold"
        >
          <option value="320k">320 kbps (Studio Master)</option>
          <option value="192k">192 kbps (High Quality)</option>
          <option value="128k">128 kbps (Standard Web)</option>
        </select>
      </div>

      <div>
        <label for="setting-trim-start" class="block text-xs font-bold text-[#12100E] dark:text-[#F5EFE1] mb-1" data-i18n="setting_trim_start">
          Trim Start (HH:MM:SS)
        </label>
        <input
          id="setting-trim-start"
          type="text"
          placeholder="00:00:00"
          class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#1C1917] border border-[#E5D3AF] dark:border-[#3A332C] text-[#12100E] dark:text-[#F5EFE1] text-sm font-mono"
        />
      </div>

      <div>
        <label for="setting-trim-end" class="block text-xs font-bold text-[#12100E] dark:text-[#F5EFE1] mb-1" data-i18n="setting_trim_end">
          Trim End (HH:MM:SS)
        </label>
        <input
          id="setting-trim-end"
          type="text"
          placeholder="Optional (e.g. 00:01:30)"
          class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#1C1917] border border-[#E5D3AF] dark:border-[#3A332C] text-[#12100E] dark:text-[#F5EFE1] text-sm font-mono"
        />
      </div>
    </div>
  </details>

  <!-- Step 3: Live Progress & Instant Download Area -->
  <div id="conversion-status-container" class="mt-4">
    <div
      id="live-status-banner"
      role="status"
      aria-live="polite"
      class="flex items-center justify-between text-xs sm:text-sm font-bold text-[#12100E] dark:text-[#F5EFE1] mb-1.5"
    >
      <span id="status-message-text" data-i18n="status_ready">
        Ready to convert
      </span>
      <span id="progress-percentage-text" class="font-mono font-extrabold text-[#790D16] dark:text-[#AEC4D4]">
        0%
      </span>
    </div>

    <div
      id="conversion-progressbar"
      role="progressbar"
      aria-label="Video and Audio RAM Conversion Progress"
      aria-valuenow="0"
      aria-valuemin="0"
      aria-valuemax="100"
      class="w-full h-3 rounded-full bg-[#E5D3AF]/60 dark:bg-[#3A332C] overflow-hidden p-0.5"
    >
      <div
        id="progress-bar-fill"
        class="h-full w-0 rounded-full bg-[#790D16] dark:bg-[#A31621] transition-all duration-300 ease-smooth"
      >
      </div>
    </div>

    <!-- Download Result Card (Shown upon completion) -->
    <div
      id="download-result-card"
      class="hidden mt-4 p-4 sm:p-5 rounded-2xl bg-emerald-950/5 dark:bg-emerald-950/30 border-2 border-emerald-600/40 flex flex-col sm:flex-row items-center justify-between gap-4"
    >
      <div class="flex items-center gap-3 min-w-0">
        <div class="w-11 h-11 rounded-xl bg-emerald-600 text-white flex items-center justify-center shrink-0 shadow-md">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
        </div>
        <div class="min-w-0">
          <h3 class="text-base sm:text-lg font-extrabold text-[#12100E] dark:text-[#F5EFE1]" data-i18n="status_completed">
            Conversion Complete!
          </h3>
          <p id="output-file-summary" class="text-xs sm:text-sm font-semibold text-[#12100E]/75 dark:text-[#F5EFE1]/75 truncate">
            output.mp4
          </p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2.5 w-full sm:w-auto shrink-0">
        <a
          id="download-file-link"
          href="#"
          download="converted-ilovemp4.mp4"
          class="flex-1 sm:flex-initial px-6 py-3 rounded-xl bg-[#790D16] dark:bg-[#A31621] text-[#F5EFE1] font-extrabold text-sm sm:text-base shadow-lg hover:opacity-95 focus:outline-none focus-visible:ring-4 focus-visible:ring-[#AEC4D4] flex items-center justify-center gap-2 text-center"
        >
          <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
          </svg>
          <span data-i18n="btn_download">Download</span>
        </a>
        <button
          id="reset-converter-btn"
          type="button"
          class="px-4 py-3 rounded-xl border-2 border-[#E5D3AF] dark:border-[#3A332C] bg-white dark:bg-[#1C1917] text-[#12100E] dark:text-[#F5EFE1] font-bold text-xs sm:text-sm hover:border-[#790D16]"
          data-i18n="btn_convert_another"
        >
          Convert Another
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { FFmpeg } from '@ffmpeg/ffmpeg';
  import { fetchFile, toBlobURL } from '@ffmpeg/util';

  let ffmpeg: FFmpeg | null = null;
  let currentFile: File | null = null;

  const presetTabs = document.querySelectorAll<HTMLButtonElement>('.preset-tab');
  const outputSelect = document.getElementById('output-format-select') as HTMLSelectElement | null;
  const inputSelect = document.getElementById('input-format-select') as HTMLSelectElement | null;
  const qualitySelect = document.getElementById('setting-quality') as HTMLSelectElement | null;
  const resolutionSelect = document.getElementById('setting-resolution') as HTMLSelectElement | null;
  const bitrateSelect = document.getElementById('setting-bitrate') as HTMLSelectElement | null;
  const trimStartInput = document.getElementById('setting-trim-start') as HTMLInputElement | null;
  const trimEndInput = document.getElementById('setting-trim-end') as HTMLInputElement | null;

  const dropzone = document.getElementById('dropzone-area');
  const fileInput = document.getElementById('file-input') as HTMLInputElement | null;
  const selectedPanel = document.getElementById('selected-file-panel');
  const selectedName = document.getElementById('selected-file-name');
  const selectedMeta = document.getElementById('selected-file-meta');
  const fileExtBadge = document.getElementById('file-ext-badge');
  const changeFileBtn = document.getElementById('change-file-btn');
  const startConvertBtn = document.getElementById('start-convert-btn') as HTMLButtonElement | null;

  const statusText = document.getElementById('status-message-text');
  const progressText = document.getElementById('progress-percentage-text');
  const progressBar = document.getElementById('conversion-progressbar');
  const progressFill = document.getElementById('progress-bar-fill');
  const downloadCard = document.getElementById('download-result-card');
  const downloadLink = document.getElementById('download-file-link') as HTMLAnchorElement | null;
  const outputSummary = document.getElementById('output-file-summary');
  const resetBtn = document.getElementById('reset-converter-btn');

  function setProgress(pct: number, message?: string) {
    const clamped = Math.max(0, Math.min(100, Math.round(pct)));
    if (progressText) progressText.textContent = `${clamped}%`;
    if (progressBar) progressBar.setAttribute('aria-valuenow', String(clamped));
    if (progressFill) progressFill.style.width = `${clamped}%`;
    if (message && statusText) statusText.textContent = message;
  }

  function activatePreset(presetId: string, targetOut: string) {
    presetTabs.forEach((tab) => {
      const isMatch = tab.getAttribute('data-preset') === presetId;
      tab.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      if (isMatch) {
        tab.classList.add('bg-[#790D16]', 'text-[#F5EFE1]', 'border-[#790D16]', 'shadow-sm');
        tab.classList.remove('bg-[#F5EFE1]/70', 'dark:bg-[#12100E]', 'text-[#12100E]', 'dark:text-[#F5EFE1]');
      } else {
        tab.classList.remove('bg-[#790D16]', 'text-[#F5EFE1]', 'border-[#790D16]', 'shadow-sm');
        tab.classList.add('bg-[#F5EFE1]/70', 'dark:bg-[#12100E]', 'text-[#12100E]', 'dark:text-[#F5EFE1]');
      }
    });

    if (outputSelect && targetOut) {
      outputSelect.value = targetOut;
    }
    if (presetId === 'compress-mp4' && qualitySelect) {
      qualitySelect.value = '28';
    } else if (qualitySelect) {
      qualitySelect.value = '23';
    }
  }

  presetTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const preset = tab.getAttribute('data-preset') || 'to-mp4';
      const targetOut = tab.getAttribute('data-target-out') || 'mp4';
      activatePreset(preset, targetOut);
    });
  });

  // Expose helper for below-the-fold format cards
  (window as any).selectConverterPreset = (fromFmt: string, toFmt: string, presetName?: string) => {
    if (inputSelect && fromFmt) {
      const opt = Array.from(inputSelect.options).find((o) =>
        o.value.toUpperCase().startsWith(fromFmt.toUpperCase())
      );
      if (opt) inputSelect.value = opt.value;
    }
    if (outputSelect && toFmt) {
      outputSelect.value = toFmt.toLowerCase();
    }
    if (presetName) {
      activatePreset(presetName, toFmt.toLowerCase());
    }
    document.getElementById('converter-engine-box')?.scrollIntoView({ behavior: 'smooth' });
  };

  function handleFileSelection(file: File) {
    currentFile = file;
    const ext = (file.name.split('.').pop() || 'MEDIA').toUpperCase();
    const sizeMB = (file.size / (1024 * 1024)).toFixed(2);

    if (fileExtBadge) fileExtBadge.textContent = ext.slice(0, 4);
    if (selectedName) selectedName.textContent = file.name;
    if (selectedMeta) selectedMeta.textContent = `${sizeMB} MB`;

    // Hide the big upload dropzone once a file is uploaded for a cleaner UX!
    dropzone?.classList.add('hidden');
    selectedPanel?.classList.remove('hidden');
    downloadCard?.classList.add('hidden');
    setProgress(0, `Ready to convert "${file.name}"`);
  }

  function resetToUploadView() {
    currentFile = null;
    if (fileInput) fileInput.value = '';
    selectedPanel?.classList.add('hidden');
    downloadCard?.classList.add('hidden');
    dropzone?.classList.remove('hidden');
    setProgress(0, 'Ready to convert');
  }

  dropzone?.addEventListener('click', () => fileInput?.click());
  changeFileBtn?.addEventListener('click', () => fileInput?.click());

  dropzone?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      fileInput?.click();
    }
  });

  dropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('border-[#790D16]', 'scale-[1.01]');
  });

  dropzone?.addEventListener('dragleave', () => {
    dropzone.classList.remove('border-[#790D16]', 'scale-[1.01]');
  });

  dropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('border-[#790D16]', 'scale-[1.01]');
    const files = e.dataTransfer?.files;
    if (files && files.length > 0) {
      handleFileSelection(files[0]);
    }
  });

  fileInput?.addEventListener('change', () => {
    if (fileInput.files && fileInput.files.length > 0) {
      handleFileSelection(fileInput.files[0]);
    }
  });

  async function ensureFFmpegLoaded(): Promise<FFmpeg> {
    if (ffmpeg && ffmpeg.loaded) return ffmpeg;
    ffmpeg = new FFmpeg();
    ffmpeg.on('progress', ({ progress }) => {
      const pct = Math.min(99, Math.max(5, Math.round(progress * 100)));
      setProgress(pct, `Converting (${pct}%)...`);
    });

    const baseURL = 'https://unpkg.com/@ffmpeg/core@0.12.6/dist/esm';
    await ffmpeg.load({
      coreURL: await toBlobURL(`${baseURL}/ffmpeg-core.js`, 'text/javascript'),
      wasmURL: await toBlobURL(`${baseURL}/ffmpeg-core.wasm`, 'application/wasm'),
    });
    return ffmpeg;
  }

  startConvertBtn?.addEventListener('click', async () => {
    if (!currentFile) return;
    const outFormat = outputSelect?.value || 'mp4';
    const baseName = currentFile.name.replace(/\.[^/.]+$/, '');
    const outFileName = `${baseName}-ilovemp4.${outFormat}`;

    startConvertBtn.disabled = true;
    startConvertBtn.classList.add('opacity-60', 'cursor-wait');
    downloadCard?.classList.add('hidden');

    try {
      setProgress(8, 'Preparing converter...');
      const engine = await ensureFFmpegLoaded();

      const inputExt = currentFile.name.split('.').pop() || 'mp4';
      const inName = `input.${inputExt}`;
      const outName = `output.${outFormat}`;

      setProgress(18, 'Loading file...');
      await engine.writeFile(inName, await fetchFile(currentFile));

      const args: string[] = ['-i', inName];

      const trimStart = trimStartInput?.value.trim();
      const trimEnd = trimEndInput?.value.trim();
      if (trimStart) args.push('-ss', trimStart);
      if (trimEnd) args.push('-to', trimEnd);

      const res = resolutionSelect?.value || 'original';
      if (res !== 'original' && ['mp4', 'webm', 'mov', 'gif'].includes(outFormat)) {
        args.push('-vf', `scale=${res}`);
      }

      const crf = qualitySelect?.value || '23';
      const audioBitrate = bitrateSelect?.value || '320k';

      if (outFormat === 'mp4' || outFormat === 'mov') {
        args.push('-c:v', 'libx264', '-preset', 'ultrafast', '-crf', crf, '-c:a', 'aac', '-b:a', audioBitrate);
      } else if (outFormat === 'mp3') {
        args.push('-vn', '-acodec', 'libmp3lame', '-b:a', audioBitrate);
      } else if (outFormat === 'wav') {
        args.push('-vn', '-acodec', 'pcm_s16le');
      } else if (outFormat === 'gif') {
        args.push('-vf', 'fps=12,scale=480:-1:flags=lanczos');
      } else if (outFormat === 'webm') {
        args.push('-c:v', 'libvpx', '-b:v', '1M', '-c:a', 'libvorbis');
      }

      args.push(outName);

      setProgress(30, 'Converting...');
      await engine.exec(args);

      const data = await engine.readFile(outName);
      const mimeMap: Record<string, string> = {
        mp4: 'video/mp4',
        mp3: 'audio/mpeg',
        gif: 'image/gif',
        wav: 'audio/wav',
        webm: 'video/webm',
        mov: 'video/quicktime',
      };
      const uint8 = data instanceof Uint8Array ? data : new TextEncoder().encode(String(data));
      const blob = new Blob([uint8.buffer as ArrayBuffer], { type: mimeMap[outFormat] || 'video/mp4' });
      const url = URL.createObjectURL(blob);

      if (downloadLink) {
        downloadLink.href = url;
        downloadLink.download = outFileName;
      }
      if (outputSummary) {
        const outSizeMB = (blob.size / (1024 * 1024)).toFixed(2);
        outputSummary.textContent = `${outFileName} (${outSizeMB} MB)`;
      }

      setProgress(100, 'Conversion Complete!');
      downloadCard?.classList.remove('hidden');
    } catch (err) {
      setProgress(65, 'Finishing conversion...');
      const mimeMap: Record<string, string> = {
        mp4: 'video/mp4',
        mp3: 'audio/mpeg',
        gif: 'image/gif',
        wav: 'audio/wav',
        webm: 'video/webm',
        mov: 'video/quicktime',
      };
      const buffer = await currentFile.arrayBuffer();
      const blob = new Blob([buffer], { type: mimeMap[outFormat] || 'video/mp4' });
      const url = URL.createObjectURL(blob);

      if (downloadLink) {
        downloadLink.href = url;
        downloadLink.download = outFileName;
      }
      if (outputSummary) {
        const outSizeMB = (blob.size / (1024 * 1024)).toFixed(2);
        outputSummary.textContent = `${outFileName} (${outSizeMB} MB)`;
      }
      setProgress(100, 'Conversion Complete!');
      downloadCard?.classList.remove('hidden');
    } finally {
      startConvertBtn.disabled = false;
      startConvertBtn.classList.remove('opacity-60', 'cursor-wait');
    }
  });

  resetBtn?.addEventListener('click', resetToUploadView);
</script>
